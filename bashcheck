#!/usr/bin/env bash

if ! command -v shellcheck &> /dev/null; then
	echo "Error: shellcheck is not installed." >&2
	exit 1
fi
exit_code=0
shopt -s globstar nullglob
for file in **/*; do
	[[ -d "$file" ]] && continue
	[[ "$file" == ./* ]] && continue
	is_shell_script=false
	if [[ "$file" =~ \.(sh|bash)$ ]]; then
		is_shell_script=true
	elif [[ -r "$file" && -f "$file" ]]; then
		first_line=$(head -n 1 "$file" 2>/dev/null || true)
		if [[ "$first_line" =~ ^#\!.*(bash|sh|zsh|ksh) ]]; then
			is_shell_script=true
		fi
	fi
	if [ "$is_shell_script" = true ]; then
		if ! output=$(shellcheck "$file" 2>&1); then
			echo "Errors found in $file" >&2
			echo "$output" >&2
			exit_code=1
		fi
	fi
done
exit "$exit_code"
